# ===== 基础设施 =====
# ===== 日志 =====
# 日志文件保存目录，控制台 + 滚动文件 + 错误文件三路输出
AGENTGATE_LOG_PATH=runtime/

# Database backend: sqlite (default) or tdsql.
AGENTGATE_DB_TYPE=sqlite
# SQLite 数据库文件路径，API 和 Worker 必须使用相同的绝对路径
AGENTGATE_DB=agentgate-demo.db
# MySQL 数据库配置
AGENTGATE_TDSQL_URL=mysql+pymysql://localhost:3306/eric
AGENTGATE_TDSQL_USER=eric
AGENTGATE_TDSQL_PASSWORD=


# Redis broker 部署模式：single（默认）或 cluster
AGENTGATE_REDIS_MODE=single
# Redis broker 地址，Celery 用它收发任务消息。
# single 模式沿用普通 Redis URL；cluster 模式填写任一可访问的集群节点且只能使用 /0。
AGENTGATE_REDIS_URL=redis://127.0.0.1:6379/0
# Cluster 模式下强制所有 Celery broker key 位于同一 hash slot，避免 CROSSSLOT。
AGENTGATE_REDIS_CLUSTER_HASH_TAG={agentgate}


# ===== 行内 Agent 对接 =====
# 客户 Agent 平台根地址。适配器会在这些地址后追加创建、健康检查、聊天和删除路径。
# 当前开发/测试环境四类接口使用同一网关；如生产环境拆分网关，可分别修改对应配置。
AGENTGATE_INBANK_CREATE_BASE_URL=http://inbank-agent-gateway.example.invalid

# ChatABC：基础编排与工作流
AGENTGATE_INBANK_CHATABC_HEALTH_BASE_URL=http://inbank-agent-gateway.example.invalid
AGENTGATE_INBANK_CHATABC_POD_API_BASE_URL=http://inbank-agent-gateway.example.invalid
AGENTGATE_INBANK_CHATABC_DELETE_BASE_URL=http://inbank-agent-gateway.example.invalid
# Pod 删除请求 data.agent_namespace；客户当前约定固定传 chatabc。
AGENTGATE_INBANK_CHATABC_AGENT_NAMESPACE=chatabc

# 云虾
AGENTGATE_INBANK_YUNXIA_HEALTH_BASE_URL=http://inbank-agent-gateway.example.invalid
AGENTGATE_INBANK_YUNXIA_POD_API_BASE_URL=http://inbank-agent-gateway.example.invalid
AGENTGATE_INBANK_YUNXIA_DELETE_BASE_URL=http://inbank-agent-gateway.example.invalid
AGENTGATE_INBANK_YUNXIA_AGENT_NAMESPACE=chatabc
# 云虾 customer_id 的隔离前缀；适配器会为每个 Run 自动追加随机后缀。
AGENTGATE_INBANK_YUNXIA_TEST_CUSTOMER_PREFIX=agentgate

# 单次客户请求、Pod 最长启动等待时间和健康检查轮询间隔（秒）。
AGENTGATE_INBANK_REQUEST_TIMEOUT_SECONDS=600
AGENTGATE_INBANK_HEALTH_WAIT_SECONDS=600
AGENTGATE_INBANK_HEALTH_POLL_INTERVAL_SECONDS=5
# 仅排障时改为 1；会在 SSE 解析失败时记录客户原始响应，不建议生产环境长期开启。
AGENTGATE_INBANK_DEBUG_SSE_FAILURES=0


# 任务调度类型：celery（默认）或 bjs；bjs 模式无需启动 Redis 和 Celery
# In BJS mode, scripts/run.sh scheduler releases due Runs without Redis.
# External schedulers may instead invoke scripts/run.sh dispatch-due periodically.
AGENT_TASK_DISPATCHER_TYPE=celery
# ===== BJS 调度（仅当 AGENT_TASK_DISPATCHER_TYPE=bjs 时生效）=====
# BJS 测评任务提交接口的完整 URL；submit() 会自动追加 taskId 和 jobId 查询参数
# The URL must not contain credentials, a query string, or a fragment.
AGENTGATE_BJS_SUBMIT_URL=http://web-llmaif-dev.aisp.test.abc/web/eval/job/bjs/submit
# BJS 作业模板 ID，由 BJS 平台提供
AGENTGATE_BJS_JOB_ID=ai11


# ===== Trace Server 取证（被测 Agent 评测证据来源）=====
# 行内 Trace Server 查询面地址；评测执行时按 SSE trace 事件引用的 trace_id 前来申请证据。
# Must be an absolute HTTP(S) origin without query string or fragment.
AGENTGATE_TRACE_SERVER_URL=http://127.0.0.1:8210


# ===== Celery Worker =====
# Worker 并发数，默认 1 表示串行执行，保护 SQLite
AGENTGATE_WORKER_CONCURRENCY=1
# 单个 Run 任务的最大执行时长（秒），超时硬终止
AGENTGATE_TASK_TIME_LIMIT_SECONDS=360
# Beat 定时调度间隔（秒），每隔多久扫描一次到期 Run
AGENTGATE_SCHEDULER_INTERVAL_SECONDS=10

# ===== 并行限制 =====
# 每个 api_key 允许的最大并行任务数（PENDING + RUNNING），api_key 为空时同样适用
# AGENTGATE_MAX_CONCURRENT_RUNS_PER_API_KEY=10
# Run 派发失败后最大重试次数（超过后转为 FAILED）
# AGENTGATE_MAX_DISPATCH_ATTEMPTS=10


# ===== LLM Judge（可选，四项全设或全不设；不设则走纯规则评估）=====
# 调用方式：api（默认，通过 HTTP 调用 OpenAI-compatible 接口）或 sdk（通过 abc_llm_sdk 调用行内大模型网关 SKD 模式下只需要提供API_KEY 和 NODEL_ID）
# AGENTGATE_JUDGE_TRANSPORT=api
# AGENTGATE_JUDGE_PROVIDER_ID=openai-compatible
# AGENTGATE_JUDGE_BASE_URL=https://provider.example/v1
# AGENTGATE_JUDGE_API_KEY=your-api-key
# AGENTGATE_JUDGE_MODEL_ID=your-model-id
# 以下三项仅在 AGENTGATE_JUDGE_TRANSPORT=sdk 时需要配置（行内大模型网关认证凭证，由平台分配）
# AGENTGATE_JUDGE_SIGNATURE_HEX=your-signature
# AGENTGATE_JUDGE_ORIGINAL_DIGEST_HEX=your-digest
# AGENTGATE_JUDGE_SESSION_ID=your-session-id

# ===== API Key 加密（平台评测任务必填；不设则提交接口返回 503）=====
# 使用 URL-safe Base64 编码的 32 字节固定密钥；部署后不要随意更换。
# AGENTGATE_API_KEY_ENCRYPTION_KEY=

# ===== 被测 Agent 服务地址 =====
# 本地银行智能体服务地址（bank-evaluations 路由使用）
AGENTGATE_BANK_BASE_URL=http://127.0.0.1:8107

# AGENTGATE_AGENT_PLATFORM_MODE=mock
# Agent 平台服务地址
AGENTGATE_AGENT_PLATFORM_ORIGIN=http://127.0.0.1:8119
